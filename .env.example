NODE_ENV=development
HOST=0.0.0.0
PORT=3000
ADMIN_API_KEY=replace-with-at-least-24-random-characters
DATA_DIR=./data
PUBLIC_BASE_URL=http://localhost:3000

EMBEDDING_PROVIDER=local
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Chat LLM: local needs no remaining LLM settings.
LLM_PROVIDER_TYPE=local
LLM_PROVIDER_NAME=local
# For any OpenAI-compatible service, set all three and the referenced secret:
# LLM_PROVIDER_TYPE=openai-compatible
# LLM_PROVIDER_NAME=nvidia
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=moonshotai/kimi-k2.6
LLM_API_KEY_ENV=LLM_API_KEY
LLM_API_KEY=
LLM_TEMPERATURE=0
# LLM_TOP_P=1
# LLM_MAX_TOKENS=1024
LLM_STREAM=false
LLM_TIMEOUT_MS=15000
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_MS=250
# Defaults preserve standard OpenAI-compatible endpoints.
LLM_CHAT_PATH=/chat/completions
LLM_HEALTH_PATH=/models
# JSON object of non-secret query parameters (for example {"api-version":"2024-10-21"}).
# Do not put keys/tokens in the URL; the referenced LLM_API_KEY_ENV is the only key source.
LLM_QUERY_PARAMS={}
# Authorization is generated from LLM_API_KEY_ENV and cannot be supplied via LLM_HEADERS.
LLM_AUTH_HEADER_NAME=authorization
LLM_AUTH_SCHEME=Bearer
# JSON object of extra non-secret headers; auth, content type, and transport headers are blocked.
LLM_HEADERS={}
# Opt-in bounded redacted RAG diagnostics; keep disabled in normal production operation.
ORBIT_RAG_DIAGNOSTICS=0

# Azure OpenAI example (uncomment/adapt together with the compatible settings above):
# LLM_BASE_URL=https://YOUR-RESOURCE.openai.azure.com
# LLM_MODEL=YOUR-DEPLOYMENT
# LLM_CHAT_PATH=/openai/deployments/YOUR-DEPLOYMENT/chat/completions
# LLM_HEALTH_PATH=/openai/models
# LLM_QUERY_PARAMS={"api-version":"2024-10-21"}
# LLM_API_KEY_ENV=AZURE_OPENAI_API_KEY
# AZURE_OPENAI_API_KEY=
# LLM_AUTH_HEADER_NAME=api-key
# LLM_AUTH_SCHEME=

DATABASE_PROVIDER=sqlite
STORAGE_PROVIDER=local
VECTOR_PROVIDER=local
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
NOTIFICATION_PROVIDER=outbox
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional only for deployments that provide tenant JWT claims; backend writes normally use service role.
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=knowledge
SUPABASE_OUTBOX_TABLE=notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
